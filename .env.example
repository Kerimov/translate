DEEPSEEK_API_KEY=your_api_key_here

# Incoming: game/team voice (BlackHole input). Run: python -m src.main --list-devices
# TEAM_AUDIO_DEVICE=2

# Outgoing: your real microphone (default mic if unset)
# MIC_INPUT_DEVICE=0

# Outgoing: virtual mic for Steam (BlackHole output — Steam uses BlackHole as mic)
# VIRTUAL_MIC_DEVICE=3

# Whisper models
WHISPER_MODEL_IN=small.en
WHISPER_MODEL_OUT=small

# TTS voice for English output (edge-tts). Examples: en-US-GuyNeural, en-US-JennyNeural
TTS_VOICE=en-US-GuyNeural

# Enable RU → EN voice output to virtual mic
ENABLE_OUTGOING=true

# Show original English text above translation
SHOW_ORIGINAL=true
