DEEPSEEK_API_KEY=your_api_key_here

# --- Windows (рекомендуется для CS2) ---
# Захват звука игры через WASAPI loopback (включено по умолчанию на Windows)
TEAM_LOOPBACK=true
# TEAM_AUDIO_DEVICE=4   # индекс устройства вывода (наушники), если не default

# Ваш микрофон
# MIC_INPUT_DEVICE=1

# VB-Audio Virtual Cable — CABLE Input (выход TTS → Steam слушает CABLE Output)
# VIRTUAL_MIC_DEVICE=5

# --- macOS ---
# TEAM_LOOPBACK=false
# TEAM_AUDIO_DEVICE=2     # BlackHole input
# VIRTUAL_MIC_DEVICE=3    # BlackHole output

# small.en — баланс скорости и качества на CPU; medium.en только с CUDA
WHISPER_MODEL_IN=small.en
WHISPER_MODEL_OUT=small

# Качество (не включайте WHISPER_VAD для голоса из игры — режет речь)
QUALITY_MODE=true
WHISPER_BEAM_SIZE=3
WHISPER_VAD=false
SEGMENT_SILENCE_FRAMES=12

# Скорость: FAST_MODE=true — base-модели + меньше пауза перед переводом
# FAST_MODE=true
# WHISPER_DEVICE=auto          # auto | cuda | cpu

# TTS voice (edge-tts): en-US-GuyNeural, en-US-JennyNeural
TTS_VOICE=en-US-GuyNeural

# false = только субтитры команды (EN → RU), без перевода вашего голоса
ENABLE_OUTGOING=true
SHOW_ORIGINAL=true
